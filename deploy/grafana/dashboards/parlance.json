{
  "uid": "parlance-overview",
  "title": "Parlance — overview",
  "timezone": "Africa/Lagos",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "parlance"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by route group",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (group) (rate(parlance_http_requests_total[1m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Server errors (share of requests)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(parlance_http_requests_total{code=\"5xx\"}[5m])) / clamp_min(sum(rate(parlance_http_requests_total[5m])), 0.001)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency by route group",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, group) (rate(parlance_http_request_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Order-to-ack p50 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(parlance_order_ack_seconds_bucket[5m])))"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(parlance_order_ack_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Matching time p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(parlance_matching_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "WebSocket fan-out p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(parlance_ws_fanout_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Outbox depth",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "parlance_outbox_depth"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Job age since last success",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "parlance_job_last_success_age_seconds"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Backup and WAL age",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "parlance_status{name=~\"backup_age_seconds|wal_segment_age_seconds\"}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Verifiers (1 = ok)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "parlance_status{name=~\"verifier_ok_.*\"}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Operating switches (1 = on)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "parlance_status{name=~\"switch_.*\"}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Disk free",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "parlance_disk_free_bytes / parlance_disk_total_bytes"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Database and WAL size",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "parlance_db_size_bytes"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Process memory",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "parlance_process_resident_memory_bytes"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Site probe and certificate days left",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"site\"}"
        },
        {
          "refId": "B",
          "expr": "(probe_ssl_earliest_cert_expiry{job=\"site\"} - time()) / 86400"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Backup sidecar verify (1 = ok)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "parlance_backup_verify_ok"
        }
      ]
    },
    {
      "id": 100,
      "type": "logs",
      "title": "Errors and alerts (Loki)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 64
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\"} |= \"\\\"level\\\":\\\"error\\\"\" or {job=\"docker\"} |= \"alert firing\""
        }
      ]
    },
    {
      "id": 101,
      "type": "logs",
      "title": "Audit-chain anchors (RS5)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 74
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\"} |= \"audit_anchor\""
        }
      ]
    }
  ]
}
