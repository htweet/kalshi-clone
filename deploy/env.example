# Copy to deploy/.env (git-ignored) and fill in. Placeholders in <angle brackets> are the owner's choices that are not
# made yet (domain, bucket provider, alert channels); everything else is the recommended standard (CLONE_SPEC.md §39).
# Secrets do not go here: deploy/init-secrets.sh writes the key ring and the backup key into deploy/secrets/.

# ---- domains (the domain is not chosen yet): the public site and the separate admin host
SITE_HOST=<example.ng>
ADMIN_HOST=<admin.example.ng>
PUBLIC_ORIGIN=https://<example.ng>
ADMIN_ORIGIN=https://<admin.example.ng>
ACME_EMAIL=<owner@example.ng>
SECURITY_CONTACT=mailto:<security@example.ng>

# ---- Cloudflare in front (docs/runbooks/cloudflare.md): its published IP ranges, space-separated, so Caddy takes the
# client address from CF-Connecting-IP only when the request really came through Cloudflare.
CLOUDFLARE_IPS=127.0.0.1/32

# ---- object storage and backups (the S3-compatible provider is not chosen yet): local folders until then
OBJECT_STORAGE=local:/data/objects
BACKUP_STORAGE=local:/backups
# BACKUP_STORAGE=s3
# BACKUP_S3_ENDPOINT=https://<provider endpoint>
# BACKUP_S3_REGION=auto
# BACKUP_S3_BUCKET=<parlance-backups>
# BACKUP_S3_ACCESS_KEY_ID=<access key id>
# BACKUP_S3_SECRET_ACCESS_KEY=<secret access key>
# OBJECT_STORAGE=s3
# S3_ENDPOINT=https://<provider endpoint>
# S3_BUCKET=<parlance-media>
# S3_ACCESS_KEY_ID=<access key id>
# S3_SECRET_ACCESS_KEY=<secret access key>

# ---- email for members (and the app's own alert emails)
SMTP_URL=<smtps://user:pass@smtp.provider:465>
MAIL_FROM=<no-reply@example.ng>

# ---- alerts to the owner's phone and email (Alertmanager)
ALERT_EMAIL=<owner@example.ng>
ALERT_SMTP_HOST=<smtp.provider:587>
ALERT_SMTP_FROM=<alerts@example.ng>
ALERT_SMTP_USER=<user>
ALERT_SMTP_PASSWORD=<password>
ALERT_PHONE_WEBHOOK=<https://ntfy.sh/your-private-topic or an SMS gateway URL>

# ---- the image to run (CI publishes one per merge; default: build locally)
PARLANCE_IMAGE=parlance:local
