{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./clone/.env*)",
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(/clone/.env*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./clone/data/**)",
      "Read(/clone/data/**)",
      "Read(./clone/data/secret.key)",
      "Read(/clone/data/secret.key)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*.db)",
      "Read(**/*.db-wal)",
      "Read(**/*.sqlite)",
      "Read(**/*.sqlite3)",
      "Read(**/secrets/**)",
      "Read(**/config/production*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.npmrc)",
      "Read(~/.config/gh/**)",
      "Edit(/clone/data/**)",
      "Edit(/.git/**)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(cat clone/.env*)",
      "Bash(cat ./clone/.env*)",
      "Bash(cat clone/data/*)",
      "Bash(cat ./clone/data/*)",
      "Bash(cat data/*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(source .env*)",
      "Bash(. .env*)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(sqlite3 clone/data/*)",
      "Bash(sqlite3 ./clone/data/*)",
      "Bash(sqlite3 data/*)",
      "Bash(cat *.pem)",
      "Bash(cat *.key)",
      "Bash(openssl * -in *.key*)",
      "Bash(base64 *.key)",
      "Bash(base64 *.pem)",
      "Bash(xxd clone/data/*)",
      "Bash(strings clone/data/*)",
      "Bash(git config core.hooksPath *)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)"
    ]
  }
}
