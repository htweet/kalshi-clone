ket surplus. On the supply side, a large share of palladium comes from Russia and South Africa, so sanctions or mining disruptions in either country can affect the price.\\n\\nWhat to watch: Tariff and sanctions news, auto sales data, and Federal Reserve meetings.\",\"funding_schedule\":\"0 10 * * *\",\"index_provider\":\"Pyth Palladium Reference Rate\",\"keywords\":[\"palladium\",\"xpd\",\"metals\",\"precious metals\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"live_data_asset\":\"PYTH:XPDUSD\",\"market_screen_title\":\"Palladium\",\"shareable_accent_color\":\"#C1BFAC\",\"shareable_layer2_background_color\":\"#662E2D29\",\"shareable_layer2_border_color\":\"#C1BFAC\",\"shareable_layer2_color\":\"#2E2D29\",\"shareable_layer2_gradient_bottom_color\":\"#2E2D29\",\"shareable_layer2_gradient_top_color\":\"#C1BFAC\",\"subaccount_id\":90,\"subcategory\":\"Palladium\",\"trading_hours\":\"Sun 6pm \u2013 Fri 5pm ET\"},\"product_metadata_derived\":{},\"recent_notional_volume\":2841458.5192,\"recent_volume\":2936000,\"search_score\":16000,\"series_ticker\":\"KXPALLADIUMPERP\",\"series_title\":\"Palladium\",\"tags\":[\"Palladium\"],\"ticker\":\"KXPALLADIUMPERP\",\"title\":\"Palladium\",\"topic_keywords\":[\"palladium\",\"xpd\",\"metals\",\"precious metals\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"total_market_count\":0,\"total_notional_volume\":55390696.1403,\"total_series_volume\":0,\"total_volume\":49938458,\"type\":\"margin\"},{\"active_market_count\":0,\"asset_class\":\"Crypto\",\"category\":\"Crypto\",\"contract_size\":1,\"derived_decimal_count\":4,\"event_subtitle\":\"\",\"event_ticker\":\"KXADAPERP\",\"event_title\":\"ADA\",\"fee_multiplier\":0,\"fee_type\":\"\",\"funding_rate\":0,\"funding_time\":\"2026-11-03T12:21:16.269579Z\",\"halt_sources\":[],\"is_closing\":false,\"is_new\":false,\"is_price_delta\":false,\"is_trending\":false,\"last_price\":0.1901,\"leverage_estimate\":3.1627,\"leverage_estimates\":{\"1000\":3.1549,\"10000\":3.1229,\"100000\":2.973