irectURL": "", "headersSize": -1, "bodySize": -1}, "cache": {}, "timings": {"blocked": 382.0709999854788, "dns": -1, "ssl": -1, "connect": -1, "send": 1.8210000000000015, "wait": 334.4819999454394, "receive": 9.003000101074576, "_blocked_queueing": 359.6329999854788, "_workerStart": -1, "_workerReady": -1, "_workerFetchStart": -1, "_workerRespondWithSettled": -1}}, {"startedDateTime": "2026-11-03T12:21:56.047Z", "_original_index": 156, "request": {"method": "GET", "url": "https://api.elections.kalshi.com/v1/series/?series_tickers=SENATEMI", "httpVersion": "http/2.0", "headers": [{"name": "accept", "value": "application/json"}, {"name": "origin", "value": "https://kalshi.com"}, {"name": "_present_security_headers", "value": "x-appsflyer-web-id,x-aws-waf-token,x-csrf-token,x-fbp"}], "queryString": [], "cookies": [], "headersSize": -1, "bodySize": 0}, "response": {"status": 200, "statusText": "", "httpVersion": "http/2.0", "headers": [{"name": "access-control-allow-origin", "value": "https://kalshi.com"}, {"name": "access-control-expose-headers", "value": "X-Csrf-Token,Etag"}, {"name": "cache-control", "value": "public, max-age=20"}, {"name": "content-security-policy", "value": "default-src 'none';"}, {"name": "content-type", "value": "application/json; charset=utf-8"}, {"name": "vary", "value": "Origin,Accept-Language,Accept-Encoding"}], "cookies": [], "content": {"mimeType": "application/json", "text": "{\"series\":[{\"ticker\":\"SENATEMI\",\"frequency\":\"custom\",\"title\":\"Michigan Senate race\",\"event_phrase_template\":\"${event}\",\"market_phrase_template\":\"${market}\",\"market_description_yes_template\":\"x\",\"market_description_no_template\":\"x\",\"category\":\"Elections\",\"tags\":[\"Senate\"],\"keywords\":[\"senate\",\"seat\",\"congress\",\"president\",\"elections\",\"democrat\",\"republican\",\"commander\",\"commander in chief\",\"inauguration\",\"usa\",\"united\",\"states\",\"america\",\"vote\",\"recount\"],\"settlement_sources\":[{\"url\":\"https://www.congress.gov/\",\"name\":\"United States Congress\"}],\"contract_url\":\"https://assets.kalshi.com/regulatory/product-certifications/SENATEPARTY.pdf\",\"image_url\":\"https://assets.kalshi.com/series-images-webp/SENATEMI.webp\",\"product_metadata\":{\"additional_prohibitions\":[[\"Holders of federal and statewide public office.\",\"\"],[\"Paid campaign staffers on Senate campaigns.\",\"\"],[\"Anyone working in a vote-tallying capacity, or who has the potential ability to observe official vote counts before they are public.\",\"\"],[\"Third-party vendors and contractors (and employees thereof) of Senatorial campaigns.\",\"\"],[\"Paid employees of Democratic and Republican Party organizations,\",\"such as the Democratic Congressional Campaign Committee or the Republican National Committee.\"],[\"Paid employees of Political Action Committees (PACs) and \\\"Super PACs\\\"\",\"(independent expenditure only political committees).\"],[\"Paid employees of major polling organizations.\",\"This prohibition does not apply to all employees of an organization that contains a polling division (e.g. the prohibition does not apply to all employees of Quinnipiac University despite the presence of Quinnipiac University\u2019s polling division). The Exchange shall determine which polling organizations constitute \\\"major\\\" and may modify that determination at any time, and will post publicly a list of those organizations on its website.\"],[\"Employees of Decision Desks at major media organizations\",\"(including, but not necessarily exclusive to, Fox News, ABC News, AP, CNN, CBS News, Decision Desk HQ and NBC News). The Exchange shall determine which media organizations constitute \\\"major\\\" and may modify that determination at any time, and will post publicly a list of those organizations on its website.\"],[\"All staff of the U.S. House of Representatives and its members.\",\"\"],[\"All staff of the U.S. Senate and its members.\",\"\"],[\"All staff of the Office of the President of the United States\",\"\"],[\"All staff of the Office of the Vice President of the United States\",\"\"],[\"All staff of the U.S. Supreme Court and its Justices\",\"\"]],\"categories\":[\"Elections\"],\"subcategories\":{\"Elections\":[\"Senate\"]}},\"discrete_underlying_unit\":null,\"forecast_unit\":0,\"forecast_formatting_rule\":\"\",\"maximum_value\":null,\"minimum_value\":null,\"series_volume\":26916116,\"fee_type\":\"quadratic\",\"fee_multiplier\":1,\"contract_ticker\":\"SENATEPARTY\",\"additional_prohibitions\":[\"Holders of federal and statewide public office.\",\"Paid campaign staffers on Senate campaigns.\",\"Anyone working in a vote-tallying capacity, or who has the potential ability to observe official vote counts before they are public.\",\"Third-party vendors and contractors (and employees thereof) of Senatorial campaigns.\",\"Paid employees of Democratic and Republican Party organizations, such as the Democratic Congressional Campaign Committee or the Republican National Committee.\",\"Paid employees of Political Action Committees (PACs) and \\\"Super PACs\\\" (independent expenditure only political committees).\",\"Paid employees of major polling organizations. This prohibition does not apply to all employees of an organization that contains a polling division (e.g. the prohibition does not apply to all employees of Quinnipiac University despite the presence of Quinnipiac University\u2019s polling division). The Exchange shall determine which polling organizations constitute \\\"major\\\" and may modify that determination at any time, and will post publicly a list of those organizations on its website.\",\"Employees of Decision Desks at major media organizations (including, but not necessarily exclusive to, Fox News, ABC News, AP, CNN, CBS News, Decision Desk HQ and NBC News). The Exchange shall determine which media organizations constitute \\\"major\\\" and may modify that determination at any time, and will post publicly a list of those organizations on its website.\",\"All staff of the U.S. House of Representatives and its members.\",\"All staff of the U.S. Senate and its members.\",\"All staff of the Office of the President of the United States\",\"All staff of the Office of the Vice President of the United States\",\"All staff of the U.S. Supreme Court and its Justices\"],\"exchange_shard\":0,\"is_visible\":true}]}"}, "redirectURL": "", "headersSize": -1, "bodySize": -1}, "cache": {}, "timings": {"blocked": 380.7940000285208, "dns": -1, "ssl": -1, "connect": -1, "send": 0.9919999999999973, "wait": 333.79000001746414, "receive": 7.058999966830015, "_blocked_queueing": 364.4240000285208, "_workerStart": -1, "_workerReady": -1, "_workerFetchStart": -1, "_workerRespondWithSettled": -1}}, {"startedDateTime": "2026-11-03T12:21:56.185Z", "_original_index": 160, "request": {"method": "GET", "url": "https://kalshi.com/api-app/midterms/senate-map?size=hero&theme=neutral", "httpVersion": "http/2.0", "headers": [{"name": "accept", "value": "*/*"}, {"name": "_present_security_headers", "value": ""}], "queryString": [], "cookies": [], "headersSize": -1, "bodySize": 0}, "response": {"status": 200, "statusText": "", "httpVersion": "http/2.0", "headers": [{"name": "cache-control", "value": "public, max-age=15, s-maxage=15"}, {"name": "content-security-policy", "value": "frame-ancestors 'self' *.kalshi.com *.kalshi.co"}, {"name": "content-type", "value": "image/png"}, {"name": "x-matched-path", "value": "/api-app/midterms/senate-map"}, {"name": "x-vercel-cache", "value": "HIT"}], "cookies": [], "content": {"mimeType": "image/png", "size": 35108, "text": "", "comment": "page/RSC body removed (may contain personal data)"}, "redirectURL": "", "headersSize": -1, "bodySize": -1}, "cache": {}, "timings": {"blocked": 13.206999949082732, "dns": -1, "ssl": -1, "connect": -1, "send": 0.8040000000000003, "wait": 181.95199999828637, "receive": 20.374000072479248, "_blocked_queueing": 5.802999949082732, "_workerStart": -1, "_wo