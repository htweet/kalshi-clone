et attention returns to older large-cap coins. It often moves with broader crypto trends rather than a unique application narrative.\",\"funding_schedule\":\"0 */8 * * *\",\"index_provider\":\"CF Benchmarks' Litecoin-Dollar Real Time Index\",\"keywords\":[\"ltc\",\"litecoin\",\"crypto\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"live_data_asset\":\"LTC\",\"market_screen_title\":\"LTC\",\"shareable_accent_color\":\"#345E9D\",\"shareable_layer2_background_color\":\"#66325F9D\",\"shareable_layer2_border_color\":\"#4575BF\",\"shareable_layer2_color\":\"#1A3761\",\"shareable_layer2_gradient_bottom_color\":\"#1A3761\",\"shareable_layer2_gradient_top_color\":\"#345E9D\",\"subaccount_id\":71,\"subcategory\":\"LTC\"},\"product_metadata_derived\":{},\"recent_notional_volume\":301581.4465,\"recent_volume\":55588,\"search_score\":3000,\"series_ticker\":\"KXLTCPERP\",\"series_title\":\"LTC\",\"tags\":[\"LTC\"],\"ticker\":\"KXLTCPERP\",\"title\":\"LTC\",\"topic_keywords\":[\"ltc\",\"litecoin\",\"crypto\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"total_market_count\":0,\"total_notional_volume\":267526951.883,\"total_series_volume\":0,\"total_volume\":54595613,\"type\":\"margin\"},{\"active_market_count\":0,\"asset_class\":\"Crypto\",\"category\":\"Crypto\",\"contract_size\":1000,\"derived_decimal_count\":7,\"event_subtitle\":\"\",\"event_ticker\":\"KXKSHIBPERP\",\"event_title\":\"kSHIB\",\"fee_multiplier\":0,\"fee_type\":\"\",\"funding_rate\":-0.0001714718137578,\"funding_time\":\"2026-11-03T12:21:16.269579Z\",\"halt_sources\":[],\"is_closing\":false,\"is_new\":false,\"is_price_delta\":false,\"is_trending\":false,\"last_price\":4.6034,\"leverage_estimate\":2.2693,\"leverage_estimates\":{\"1000\":2.2559,\"10000\":2.2023,\"100000\":1.9664,\"1000000\":1.2249},\"market_id\":\"e8bd7a88-db45-40d8-a2cb-2ea90ad2f003\",\"markets\":[],\"previous_price\":4.627,\"product_metadata\":{\"asset_name\":\"Shiba Inu\",\"categories\":[\"Crypto\"],\"category\":\"Crypto\",\"chart_gradi