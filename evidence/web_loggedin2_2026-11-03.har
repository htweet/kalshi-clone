gin_images/2026-09-24/KXLINKPERP.webp\",\"decimal_count\":2,\"description\":\"Chainlink is best known for building decentralized oracle infrastructure for blockchains. Its networks provide price feeds and other real-world data that smart-contract applications rely on to function. LINK is the token associated with that oracle ecosystem and is closely tied to the growth of onchain finance and automation. Traders often view it as infrastructure for the crypto economy rather than a typical payment coin. Adoption of data feeds, interoperability tools, and institutional partnerships can shape sentiment around LINK.\",\"funding_schedule\":\"0 */8 * * *\",\"index_provider\":\"CF Benchmarks' Chainlink-Dollar Real Time Index\",\"keywords\":[\"link\",\"chainlink\",\"crypto\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"live_data_asset\":\"LINK\",\"market_screen_title\":\"LINK\",\"shareable_accent_color\":\"#0847F8\",\"shareable_layer2_background_color\":\"#66435CA1\",\"shareable_layer2_border_color\":\"#2E5FFF\",\"shareable_layer2_color\":\"#435CA1\",\"shareable_layer2_gradient_bottom_color\":\"#435CA1\",\"shareable_layer2_gradient_top_color\":\"#0847F8\",\"subaccount_id\":69,\"subcategory\":\"LINK\"},\"product_metadata_derived\":{},\"recent_notional_volume\":515873.6434,\"recent_volume\":46122,\"search_score\":6000,\"series_ticker\":\"KXLINKPERP\",\"series_title\":\"LINK\",\"tags\":[\"LINK\"],\"ticker\":\"KXLINKPERP\",\"title\":\"LINK\",\"topic_keywords\":[\"link\",\"chainlink\",\"crypto\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"total_market_count\":0,\"total_notional_volume\":230430039.5604,\"total_series_volume\":0,\"total_volume\":23883259,\"type\":\"margin\"},{\"active_market_count\":0,\"asset_class\":\"Crypto\",\"category\":\"Crypto\",\"contract_size\":0.01,\"derived_decimal_count\":2,\"event_subtitle\":\"\",\"event_ticker\":\"KXAAVEPERP\",\"event_title\":\"AAVE\",\"fee_multiplier\":0,\"fee_type\":\"\",\"funding_rate\":0,\"funding_time\":\"2026-11-03T12: