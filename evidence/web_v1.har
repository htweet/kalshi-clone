      "text": "{\"home\":{\"highlights\":[{\"type\":\"prediction\",\"title\":\"Michigan Senate winner?\",\"about\":\"Rep. Haley Stevens, a Michigan Democrat, appeared alongside Republican Senate candidate Mike Rogers at a Detroit church Sunday and praised his support for Black-owned businesses just two days before he faces the Democratic nominee she previously backed, according to Axios. Stevens then posted a formal endorsement of Rogers on X, marking a notable break from her party ahead of Election Day.\",\"bg_image\":\"https://kalshi-fallback-images.s3.amazonaws.com/categories%2Felections%2Fmentions%201.webp\",\"bg_image_wide\":\"https://kalshi-fallback-images.s3.us-east-1.amazonaws.com/test/abdul-el-sayed-500-500-2.webp\",\"bg_image_wide_gradient\":\"\",\"bg_color\":\"\",\"card_image\":\"https://kalshi-fallback-images.s3.us-east-1.amazonaws.com/test/abdul-el-sayed-450-180-2.webp\",\"card\":{\"type\":\"contract\",\"series_ticker\":\"SENATEMI\",\"series_title\":\"Michigan Senate race\",\"event_ticker\":\"SENATEMI-26\",\"event_subtitle\":\"In 2026\",\"event_title\":\"Michigan Senate winner?\",\"total_series_volume\":20615198,\"total_event_volume\":19399849,\"recent_event_volume\":4845235,\"category\":\"Elections\",\"milestone_id\":\"43e7f3b0-3d09-5716-8370-3627cc34e957\",\"markets\":[{\"title\":\"Abdul El-Sayed\",\"yes_bid\":77,\"yes_ask\":78,\"ticker\":\"SENATEMI-26-D\",\"image_url\":\"https://assets.kalshi.com/market-images/SENATEMI-26-D.png?v=92c2cbfc94\",\"image_url_light_mode\":\"https://assets.kalshi.com/market-images/SENATEMI-26-D.png?v=92c2cbfc94\",\"image_url_dark_mode\":\"https://assets.kalshi.com/market-images/SENATEMI-26-D.png?v=92c2cbfc94\",\"background_color\":\"#AA00FF\",\"background_color_light_mode\":\"#AA00FF\",\"background_color_dark_mode\":\"#D24DFF\",\"image_scale\":100,\"price\":78,\"previous_price\":77,\"open_date\":\"2024-12-03T15:00:00Z\",\"close_date\":\"2027-11-03T15:00:00Z\",\"rank_score\":7699,\"result\":\"\",\"status\":\"active\",\"stru