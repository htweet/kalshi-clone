e\":\"#ff731919\",\"background_color_dark_mode\":\"#ff912737\",\"image_scale\":72,\"price\":67,\"previous_price\":71,\"open_date\":\"2026-10-20T04:06:00Z\",\"close_date\":\"2026-11-04T01:20:00Z\",\"rank_score\":6699,\"result\":\"\",\"status\":\"active\",\"structured_target_id\":\"aa65dda6-9cb8-4c8b-812b-d0c1feaae54f\",\"color_palette\":\"NFL-WAS\"}],\"keyword_ids\":[\"5e449b0c-41a9-493e-889c-80c36e64e218\",\"833d4b69-bad7-44a0-8ff4-07ece3bc626b\",\"945c2871-1803-4ab7-bd22-0c39d933ce74\"],\"fee_type\":\"fcm_with_maker_fees\",\"fee_multiplier\":1}},{\"type\":\"prediction\",\"title\":\"Who will control the Senate?\",\"about\":\"Control of the U.S. Senate is on the line in the 2026 midterms, with Republicans defending a 53-47 majority and Democrats needing a net gain of four seats to retake the chamber, according to 270toWin. Key battlegrounds include Maine, North Carolina, Georgia and Michigan, according to Race to the WH.\",\"bg_image\":\"https://kalshi-fallback-images.s3.amazonaws.com/categories%2Felections%2Fmentions%202.webp\",\"bg_image_wide\":\"https://kalshi-fallback-images.s3.us-east-1.amazonaws.com/test/US-Senate-650-530.jpg\",\"bg_image_wide_gradient\":\"\",\"bg_color\":\"\",\"card_image\":\"https://kalshi-fallback-images.s3.us-east-1.amazonaws.com/test/US-Senate-450-180.jpg\",\"card\":{\"type\":\"contract\",\"series_ticker\":\"CONTROLS\",\"series_title\":\"Senate winner\",\"event_ticker\":\"CONTROLS-2026\",\"event_subtitle\":\"In 2026\",\"event_title\":\"Who will control the Senate?\",\"total_series_volume\":28418171,\"total_event_volume\":26609722,\"recent_event_volume\":1664420,\"category\":\"Elections\",\"milestone_id\":\"d676fbb1-e1f2-4b19-a077-6191ecf159be\",\"markets\":[{\"title\":\"Democratic Party\",\"yes_bid\":72,\"yes_ask\":73,\"ticker\":\"CONTROLS-2026-D\",\"image_url\":\"https://assets.kalshi.com/market-images/CONTROLS-2026-D.webp\",\"image_url_light_mode\":\"https://assets.kalshi.com/market-images/CONTROLS-2026-D.webp\",\"image_url_dark_mode\":\"https://assets.kalshi.com/market-images/CONTROLS-2026-D.webp\",\"background_color\":\"#00B5D9\",\"background_color_light_mode\":\"#00B5D9\",\"background_color_dark_mode\":\"#00CBCC\",\"image_scale\":100,\"price\":73,\"previous_price\":72,\"open_date\":\"2024-11-06T15:00:00Z\",\"close_date\":\"2027-02-01T15:00:00Z\",\"rank_score\":7199,\"result\":\"\",\"status\":\"active\",\"structured_target_id\":\"57fa2293-3102-463b-9087-68cd9f6da0a6\"},{\"title\":\"Republican Party\",\"yes_bid\":27,\"yes_ask\":28,\"ticker\":\"CONTROLS-2026-R\",\"image_url\":\"https://assets.kalshi.com/market-images/CONTROLS-2026-R.png\",\"image_url_light_mode\":\"https://assets.kalshi.com/market-images/CONTROLS-2026-R.png\",\"image_url_dark_mode\":\"https://assets.kalshi.com/market-images/CONTROLS-2026-R.png\",\"background_color\":\"#FFD600\",\"background_color_light_mode\":\"#FFD600\",\"background_color_dark_mode\":\"#FFE14D\",\"image_scale\":100,\"price\":28,\"previous_price\":30,\"open_date\":\"2024-11-06T15:00:00Z\",\"close_date\":\"2027-02-01T15:00:00Z\",\"rank_score\":2699,\"result\":\"\",\"status\":\"active\",\"structured_target_id\":\"9244ed4c-9dfd-45cc-8211-996dc902f315\"}],\"keyword_ids\":[\"300f6fe9-c938-4819-9b06-b9e087ddd3d0\",\"ee944521-77b9-43a9-87b6-cf12cf7464ab\",\"8dd953c4-839f-4aca-b30b-2e792105b23a\",\"523ca448-b4c0-449c-a730-e88d2bf91a75\",\"29172742-18f1-4985-bf0d-b468fdaa8020\",\"c124579d-cd13-4a9a-a40c-6856ff7ed271\",\"48b77aa0-5117-4107-8e5a-76cb752417e6\"],\"fee_type\":\"fcm_fees\",\"fee_multiplier\":1}},{\"type\":\"prediction\",\"title\":\"Texas Senate winner?\",\"about\":\"Ken Paxton, former Texas attorney general, faces Democrat James Talarico, a state representative, in what has emerged as an unusually competitive race for a Senate seat in a reliably Republican state, according to AP. Paxton won the Republican primary after surviving his 2023 impeachment and acquittal, while Talarico has sought to consolidate support from moderate and independent voters.\",\"bg_image\":\"https://kalshi-fallback-images.s3.amazonaws.com/categories%2Felections%2Fmentions%203.webp\",\"bg_image_wide\":\"https://kalshi-fallback-images.s3.us-east-1.amazonaws.com/test/talarico-500-500-spotlight-2.jpg\",\"bg_image_wide_gradient\":\"\",\"bg_color\":\"\",\"card_image\":\"https://kalshi-fallback-images.s3.us-east-1.amazonaws.com/test/james-talarico-campaign-bus-450-180.webp\",\"card\":{\"type\":\"contract\",\"series_ticker\":\"SENATETX\",\"series_title\":\"Texas Senate race\",\"event_ticker\":\"SENATETX-26\",\"event_subtitle\":\"In 2026\",\"event_title\":\"Texas Senate winner?\",\"total_series_volume\":72446109,\"total_event_volume\":68155010,\"recent_event_volume\":4859822,\"category\":\"Elections\",\"milestone_id\":\"76109ade-7070-59c6-89e2-f004d4d53cef\",\"markets\":[{\"title\":\"James Talarico\",\"yes_bid\":71,\"yes_ask\":72,\"ticker\":\"SENATETX-26-D\",\"image_url\":\"https://assets.kalshi.com/market-images/SENATETX-26-D.png?v=4b09c25245\",\"image_url_light_mode\":\"https://assets.kalshi.com/market-images/SENATETX-26-D.png?v=4b09c25245\",\"image_url_dark_mode\":\"https://assets.kalshi.com/market-images/SENATETX-26-D.png?v=4b09c25245\",\"background_color\":\"#FF6A00\",\"background_color_light_mode\":\"#FF6A00\",\"background_color_dark_mode\":\"#FF9500\",\"image_scale\":100,\"price\":72,\"previous_price\":70,\"open_date\":\"2024-12-03T15:00:00Z\",\"close_date\":\"2027-11-03T15:00:00Z\",\"rank_score\":7099,\"result\":\"\",\"status\":\"active\",\"structured_target_id\":\"57fa2293-3102-463b-9087-68cd9f6da0a6\"},{\"title\":\"Ken Paxton\",\"yes_bid\":28,\"yes_ask\":29,\"ticker\":\"SENATETX-26-R\",\"image_url\":\"https://assets.kalshi.com/market-images/SENATETX-26-R.WEBP?v=d0f2c308f6\",\"image_url_light_mode\":\"https://assets.kalshi.com/market-images/SENATETX-26-R.WEBP?v=d0f2c308f6\",\"image_url_dark_mode\":\"https://assets.kalshi.com/market-images/SENATETX-26-R.WEBP?v=d0f2c308f6\",\"background_color\":\"#AA00FF\",\"background_color_light_mode\":\"#AA00FF\",