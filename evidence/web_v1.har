sive\":false,\"collateral_return_type\":\"\",\"title\":\"When will traffic at the Strait of Hormuz return to normal?\",\"category\":\"Politics\",\"tags\":null,\"keywords\":null,\"min_tick_size\":\"\",\"settle_details\":\"\",\"settlement_sources\":[{\"url\":\"https://portwatch.imf.org/pages/chokepoint6\",\"name\":\"IMF PortWatch\"}],\"description_context\":\"\",\"underlying\":\"If ||political stat|| is ||above/below/exactly/at least/between|| ||value|| ||time period||, then the market resolves to Yes.\",\"metrics_tags\":null,\"mini_title\":\"When will traffic at the Strait of Hormuz return to normal?\",\"sub_title\":\"Transit calls\",\"markets\":[],\"max_close_ts\":\"2029-01-01T14:59:00Z\",\"min_open_ts\":\"2026-03-17T14:00:00Z\",\"product_metadata\":{\"competition\":\"Trump\",\"competition_scope\":\"Normal Hormuz Traffic\",\"event_header_subtitle\":\"Requires 7-day moving average of traffic exceed 60\"},\"product_metadata_derived\":{\"competition\":\"Trump\",\"event_header_subtitle\":\"Requires 7-day moving average of traffic exceed 60\"},\"header_title\":\"When will traffic at the Strait of Hormuz return to normal?\",\"employment_collection_required\":false,\"exchange_shard\":0},\"KXHORMUZWEEKLY-26NOV01\":{\"id\":\"01a1692a-1e11-7916-9af4-09ee6cebafe0\",\"ticker\":\"KXHORMUZWEEKLY-26NOV01\",\"series_ticker\":\"KXHORMUZWEEKLY\",\"target_datetime\":\"2026-11-03T15:00:00Z\",\"strike_date\":\"2026-11-03T14:00:00Z\",\"mutually_exclusive\":false,\"collateral_return_type\":\"DIRECNET\",\"title\":\"Traffic through the Strait of Hormuz? (10/26 - 11/1)\",\"category\":\"Politics\",\"tags\":null,\"keywords\":null,\"min_tick_size\":\"\",\"settle_details\":\"The total is calculated by summing daily counts ||time period||. The market will resolve no earlier than Tuesday at 9 AM following the end of the period, once complete data is available.\",\"settlement_sources\":[{\"url\":\"https://portwatch.imf.org/pages/chokepoint6\",\"name\":\"IMF PortWatch\"}],\"description_context\":\"\",\"underlying\":\"If ||political stat|| is ||above/below/exactly/at least/between|| ||value|| ||time period||, then the market resolves to Yes.\",\"metrics_tags\":null,\"mini_title\":\"Traffic through the Strait of Hormuz? (10/26 - 11/1)\",\"sub_title\":\"10/26 - 11/1\",\"markets\":[],\"max_close_ts\":\"2026-11-03T14:00:00Z\",\"min_open_ts\":\"2026-10-23T16:00:00Z\",\"product_metadata\":{\"competition_scope\":\"Traffic (10/26-11/1)\"},\"header_title\":\"Traffic through the Strait of Hormuz? (10/26 - 11/1)\",\"employment_collection_required\":false,\"exchange_shard\":0},\"KXIPO-26\":{\"id\":\"b8ea8550-b70c-4ac7-b91f-e167c1fc443b\",\"ticker\":\"KXIPO-26\",\"series_ticker\":\"KXIPO\",\"target_datetime\":\"2027-01-01T15:00:00Z\",\"mutually_exclusive\":false,\"collateral_return_type\":\"\",\"title\":\"Which companies will officially announce an IPO this year?\",\"category\":\"Financials\",\"tags\":null,\"keywords\":null,\"min_tick_size\":\"\",\"settle_details\":\"An IPO is confirmed if 1) the SEC declares the company's Form S-1 effective OR 2) the IPO is priced OR 3) a securities exchange has assigned a ticker to it. As long as any of those events occur, the market will immediately resolve to Yes, even if the company does not start trading until after || Date ||.\",\"settlement_sources\":[{\"url\":\"https://www.nytimes.com\",\"name\":\"the New York Times\"},{\"url\":\"https://www.wsj.com/\",\"name\":\"The Wall Street Journal\"},{\"url\":\"https://www.bloomberg.com\",\"name\":\"Bloomberg\"},{\"url\":\"https://www.bbc.co.uk\",\"name\":\"BBC\"},{\"url\":\"https://abcnews.go.com/\",\"name\":\"ABC\"},{\"url\":\"https://www.reuters.com\",\"name\":\"Reuters\"},{\"url\":\"https://www.cnbc.com/\",\"name\":\"CNBC\"},{\"url\":\"https://www.ft.com\",\"name\":\"Financial Times\"}],\"description_context\":\"\",\"underlying\":\"If || Company || confirms an IPO before || Date ||, then the market resolves to Yes.\",\"metrics_tags\":null,\"mini_title\":\"Which companies will officially announce an IPO this year?\",\"sub_title\":\"Before 2027\",\"markets\":[],\"max_close_ts\":\"2027-01-01T04:59:00Z\",\"min_open_ts\":\"2025-11-20T03:00:00Z\",\"header_title\":\"Which companies will officially announce an IPO this year?\",\"employment_collection_required\":false,\"exchange_shard\":0},\"KXIPOANTHROPIC-DATE\":{\"id\":\"7ed8b48f-68d5-47b6-bcb4-74a3459bb3e9\",\"ticker\":\"KXIPOANTHROPIC-DATE\",\"series_ticker\":\"KXIPOANTHROPIC\",\"target_datetime\":\"2027-04-01T14:00:00Z\",\"mutually_exclusive\":false,\"collateral_return_type\":\"\",\"title\":\"When will Anthropic officially announce an IPO?\",\"category\":\"Companies\",\"tags\":null,\"keywords\":null,\"min_tick_size\":\"\",\"settle_details\":\"An IPO is confirmed if 1) the SEC declares the company's Form S-1 effective OR 2) the IPO is priced OR 3) a securities exchange has assigned a ticker to it. As long as any of those events occur, the market will immediately resolve to Yes, even if the company does not start trading until after || Date ||.\",\"settlement_sources\":[{\"url\":\"https://www.nytimes.com\",\"name\":\"the New York Times\"},{\"url\":\"https://abcnews.go.com/\",\"name\":\"ABC\"},{\"url\":\"https://www.bloomberg.com\",\"name\":\"Bloomberg\"},{\"url\":\"https://www.wsj.com/\",\"name\":\"The Wall Street Journal\"},{\"url\":\"https://www.ft.com\",\"name\":\"Financial Times\"},{\"url\":\"https://www.cnbc.com/\",\"name\":\"CNBC\"},{\"url\":\"https://www.reuters.com\",\"name\":\"Reuters\"},{\"url\":\"https://www.anthropic.com/\",\"name\":\"Anthropic\"}],\"description_context\":\"\",\"underlying\":\"If || Company || confirms an IPO before || Date ||, then the market resolves to Yes.\",\"metrics_tags\":null,\"mini_title\":\"\",\"sub_title\":\"Anthropic\",\"markets\":[],\"max_close_ts\":\"2027-04-01T03:59:00Z\",\"min_open_ts\":\"2026-04-01T14:00:00Z\",\"product_metadata\":{\"structured_icon\":\"date\"},\"header_title\":\"When will Anthropic officially announce an IPO?\",\"employment_collection_required\":false,\"exchange_shard\":0},\"KXNEXTPRESSECPERM-29JAN20\":{\"id\":\"01a145bb-eedf-781f-9238-77b9f05a3ea9\",\"ticker\":\"KXNEXTPRESSECPERM-29JAN20\",\"series_ticker\":\"KXNEXTPRESSECPERM\",\"target_datetime\":\"2029-01-27T15:00:00Z\",\"mutually_exclusive\":true,\"mutually_exclusive_side\":\"yes\",\"collateral_return_type\":\"MECNET\",\"title\":\"Who will be Trump's next Press Secretary?\",\"category\":\"Politics\",\"tags\":null,\"keywords\":null,\"min_tick_size\":\"\",\"settle_details\":\"The holder of the position at the time of Issuance is excluded.\\n\\nFor the purposes of this Contract, only a subject who holds the position in a permanent, confirmed, elected, or otherwise non-acting and non-temporary capacity, as formally designated by the body or organization at which the position is held, is treated as formally holding the position; assumption of the role solely in an acting, interim, transitional, provisional, caretaker, pro tempore, or otherwise temporary capacity does not, by itself, satisfy the Payout Criterion.\\n\\n\u201cNo new person\u201d resolves Yes only if no new person formally holds the position in a permanent capacity before Jan 20, 2029; in that case every other market resolves No.\\n\\nIf the first qualifying permanent holder is not named in this event, every market resolves No.\",\"settlement_sources\":[{\"url\":\"https://www.whitehouse.gov/\",\"name\":\"The White House\"},{\"url\":\"https://www.nytimes.com/\",\"name\":\"The New York Times\"}],\"description_context\":\"\",\"underlying\":\"If ||entity|| formally holds the position of ||position|| before ||date||, and is the first such subject to do so after Issuance, then the market resolves to Yes.\",\"metrics_tags\":null,\"mini_title\":\"Who will be Trump's next Press Secretary?\",\"sub_title\":\"Before Jan 20, 2029\",\"markets\":[],\"max_close_ts\":\"2029-01-27T15:00:00Z\",\"min_open_ts\":\"2026-10-16T17:30:00Z\",\"product_metadata\":{\"custom_image_url\":\"https://kalshi-public-docs.s3.us-east-1.amazonaws.com/series-images-webp/KXNEXTPRESSECPERM.webp\",\"event_header_subtitle\":\"Excludes acting and interim\"},\"product_metadata_derived\":{\"event_header_subtitle\":\"Excludes acting and interim\"},\"header_title\":\"Who will be Trump's next Press Secretary?\",\"employment_collection_required\":false,\"exchange_shard\":0},\"KXOMARCITIZENSHIP-27\":{\"id\":\"01a13cc8-1c27-7324-ac2f-267d71d81395\",\"ticker\":\"KXOMARCITIZENSHIP-27\",\"series_ticker\":\"KXOMARCITIZENSHIP\",\"target_datetime\":\"2027-01-01T05:00:00Z\",\"mutually_exclusive\":false,\"collateral_return_type\":\"\",\"title\":\"Will Ilhan Omar's citizenship be revoked in 2026?\",\"category\":\"Politics\",\"tags\":null,\"keywords\":null,\"min_tick_size\":\"\",\"settle_details\":\"Only a final, involuntary revocation counts: a denaturalization judgment, a final USCIS decision, or loss of citizenship triggered by a federal conviction, with all appeals resolved before the deadline. A filed case, investigation, indictment or proposed legislation does not count, and neither does voluntary renunciation.\",\"settlement_sources\":[{\"url\":\"https://www.uscis.gov/\",\"name\":\"U.S. Citizenship and Immigration Services\"},{\"url\":\"https://www.justice.gov/\",\"name\":\"the U.S. Department of Justice\"},{\"url\":\"https://pacer.uscourts.gov/\",\"name\":\"PACER\"},{\"url\":\"https://www.federalregister.gov/\",\"name\":\"Federal Register\"},{\"url\":\"https://www.nytimes.com/\",\"name\":\"The New York Times\"},{\"url\":\"https://www.ap.org\",\"name\":\"the Associated Press\"},{\"url\":\"https://www.bloomberg.com/\",\"name\":\"Bloomberg\"},{\"url\":\"https://www.reuters.com\",\"name\":\"Reuters\"},{\"url\":\"https://www.washingtonpost.com\",\"name\":\"The Washington Post\"},{\"url\":\"https://www.wsj.com/\",\"name\":\"The Wall Street Journal\"},{\"url\":\"https://www.cnn.com/\",\"name\":\"CNN\"},{\"url\":\"https://www.nbcnews.com/\",\"name\":\"NBC\"},{\"url\":\"https://www.cbsnews.com/\",\"name\":\"CBS\"},{\"url\":\"https://abcnews.go.com/\",\"name\":\"ABC\"},{\"url\":\"https://www.foxnews.com/\",\"name\":\"Fox News\"},{\"url\":\"https://www.msnbc.com\",\"name\":\"MSNBC\"},{\"url\":\"https://www.bbc.com/news\",\"name\":\"BBC News\"},{\"url\":\"https://www.politico.com\",\"name\":\"Politico\"}],\"description_context\":\"\",\"underlying\":\"If || Person || has their U.S. citizenship revoked before || Date ||, then the market resolves to Yes.\",\"metrics_tags\":null,\"mini_title\":\"Will Ilhan Omar's citizenship be revoked in 2026?\",\"sub_title\":\"Before 2027\",\"markets\":[],\"max_close_ts\":\"2027-01-01T04:59:00Z\",\"min_open_ts\":\"2026-10-15T00:05:00Z\",\"product_metadata\":{\"custom_image_url\":\"https://kalshi-public-docs.s3.us-east-1.amazonaws.com/series-images-webp/KXOMARCITIZENSHIP.webp?v=c41a451bd880\",\"event_header_subtitle\":\"Final revocation only; a filed case or charge doesn't count\"},\"product_metadata_derived\":{\"event_header_subtitle\":\"Final revocation only; a filed case or charge doesn't count\"},\"header_title\":\"Will Ilhan Omar's citizenship be revoked in 2026?\",\"employment_collection_required\":false,\"exchange_shard\":0},\"KXORBOFHARVEST-27NOV30\":{\"id\":\"3f737206-ee04-47b5-9c0f-c6b6be288a99\",\"ticker\":\"KXORBOFHARVEST-27NOV30\",\"series_ticker\":\"KXORBOFHARVEST\",\"target_datetime\":\"2027-12-07T15:00:00Z\",\"mutually_exclusive\":false,\"collateral_return_type\":\"DIRECNET\",\"title\":\"Timber harvested from Oregon BOF lands in FY2027\",\"category\":\"Economics\",\"tags\":null,\"keywords\":null,\"min_tick_size\":\"\",\"settle_details\":\"Fiscal year 2027 runs from July 1, 2026 through June 30, 2027.\\n\\nResolution will use ODF\u2019s reported BOF Timber Harvest Volume for FY2027. Only timber actually harvested from Board of Forestry Lands will count; timber merely planned, offered, or sold but not harvested during FY2027 will not count. Volume is measured in million board feet (MMBF).\",\"settlement_sources\":[{\"url\":\"https://