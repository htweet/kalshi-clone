dient_stop_color\":\"#00000000\",\"chart_gradient_stop_dark_color\":\"#00000000\",\"chart_line_color\":\"#F0B90B\",\"chart_line_dark_color\":\"#F0B90B\",\"custom_image_url\":\"https://assets.kalshi.com/app_casual/margin_images/2026-09-24/KXBNBPERP.webp\",\"decimal_count\":1,\"description\":\"BNB is the native utility token of the BNB Chain ecosystem. It is used for network transaction fees, staking, and activity across decentralized applications, and it also supports fee discounts on Binance. Traders often follow it as a proxy for usage across the BNB ecosystem and one of crypto's largest exchange-linked assets. Chain adoption, token burns, exchange activity, and regulatory developments can influence its price.\",\"funding_schedule\":\"0 */8 * * *\",\"index_provider\":\"CF BNB-Dollar Spot Rate\",\"keywords\":[\"bnb\",\"bnb chain\",\"crypto\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"live_data_asset\":\"BNB\",\"market_screen_title\":\"BNB\",\"shareable_accent_color\":\"#F0B90B\",\"shareable_layer2_background_color\":\"#660A0C0F\",\"shareable_layer2_border_color\":\"#F0B90B\",\"shareable_layer2_gradient_bottom_color\":\"#0A0C0F\",\"shareable_layer2_gradient_top_color\":\"#0C0F13\",\"subaccount_id\":107,\"subcategory\":\"BNB\"},\"product_metadata_derived\":{},\"recent_notional_volume\":735035.7285,\"recent_volume\":1031469,\"search_score\":13000,\"series_ticker\":\"KXBNBPERP\",\"series_title\":\"BNB\",\"tags\":[\"BNB\"],\"ticker\":\"KXBNBPERP\",\"title\":\"BNB\",\"topic_keywords\":[\"bnb\",\"bnb chain\",\"crypto\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"total_market_count\":0,\"total_notional_volume\":40382908.1049,\"total_series_volume\":0,\"total_volume\":54023559,\"type\":\"margin\"},{\"active_market_count\":0,\"asset_class\":\"Crypto\",\"category\":\"Crypto\",\"contract_size\":1,\"derived_decimal_count\":4,\"event_subtitle\":\"\",\"event_ticker\":\"KXLINKPERP\",\"event_title\":\"LINK\",\"fee_multiplier\":0,\"fee_type\":\"\",\"funding_rate\":0.00