s://api.elections.kalshi.com/v1/search/series?derivative_type=margin&order_by=trending", "httpVersion": "http/2.0", "headers": [{"name": ":method", "value": "GET"}, {"name": ":path", "value": "/v1/search/series?derivative_type=margin&order_by=trending"}, {"name": "accept", "value": "*/*"}, {"name": "origin", "value": "https://kalshi.com"}], "queryString": [{"name": "derivative_type", "value": "margin"}, {"name": "order_by", "value": "trending"}], "cookies": [], "headersSize": -1, "bodySize": 0}, "response": {"status": 200, "statusText": "", "httpVersion": "http/2.0", "headers": [{"name": "access-control-allow-origin", "value": "https://kalshi.com"}, {"name": "access-control-expose-headers", "value": "X-Csrf-Token,Etag"}, {"name": "age", "value": "53"}, {"name": "cache-control", "value": "public, max-age=60"}, {"name": "content-security-policy", "value": "default-src 'none';"}, {"name": "content-type", "value": "application/json; charset=utf-8"}, {"name": "date", "value": "Mon, 02 Nov 2026 11:18:45 GMT"}, {"name": "vary", "value": "Origin,Accept-Language,Accept-Encoding"}], "cookies": [], "content": {"size": 73701, "mimeType": "application/json", "text": "{\"total_results_count\":28,\"current_page\":[{\"active_market_count\":0,\"asset_class\":\"Crypto\",\"category\":\"Crypto\",\"contract_size\":0.0001,\"derived_decimal_count\":0,\"event_subtitle\":\"\",\"event_ticker\":\"KXBTCPERP\",\"event_title\":\"BTC\",\"fee_multiplier\":0,\"fee_type\":\"\",\"funding_rate\":-0.0001089283554594,\"funding_time\":\"2026-11-02T11:18:21.275812Z\",\"halt_sources\":[],\"is_closing\":false,\"is_new\":false,\"is_price_delta\":false,\"is_trending\":false,\"last_price\":7.7753,\"leverage_estimate\":6.3858,\"leverage_estimates\":{\"1000\":6.3805,\"10000\":6.3752,\"100000\":6.3436,\"1000000\":6.2105},\"market_id\":\"87c59f79-328c-4a2c-9471-3cc84a8f78e2\",\"markets\":[],\"previous_price\":7.7998,\"product_metadata\":{\"asset_name\":\"Bitcoin\",\"categories\":[\"Crypto\"],\"category\":\"Crypto\",\"chart_gradient_start_color\":\"#80F5CD90\",\"chart_gradient_start_dark_color\":\"#80CB912D\",\"chart_gradient_stop_color\":\"#00E9AC4F\",\"chart_gradient_stop_dark_color\":\"#00F5891B\",\"chart_line_color\":\"#F3A343\",\"chart_line_dark_color\":\"#FFAB59\",\"custom_image_url\":\"https://assets.kalshi.com/app_casual/margin_images/2026-09-24/KXBTCPERP.webp\",\"decimal_count\":2,\"description\":\"Bitcoin is the original cryptocurrency and the largest digital asset by market value. It is widely viewed as a decentralized store of value and the benchmark for the broader crypto market. Many traders use BTC as the reference asset for crypto sentiment, liquidity, and risk appetite. Its fixed supply and long operating history are central to its appeal. Major macro, ETF, regulatory, and institutional developments often show up in Bitcoin first.\",\"funding_schedule\":\"0 */8 * * *\",\"index_provider\":\"CF Benchmarks' Bitcoin Real Time Index\",\"keywords\":[\"btc\",\"bitcoin\",\"crypto\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"live_data_asset\":\"BTC\",\"market_screen_title\":\"BTC\",\"shareable_accent_color\":\"#F2A900\",\"shareable_layer2_background_color\":\"#66F7931A\",\"shareable_layer2_border_color\":\"#F7931A\",\"shareable_layer2_color\":\"#F7931A\",\"shareable_layer2_gradient_bottom_color\":\"#F7931A\",\"shareable_layer2_gradient_top_color\":\"#F7931A\",\"subaccount_id\":64,\"subcategory\":\"BTC\"},\"product_metadata_derived\":{},\"recent_notional_volume\":241786559.2271,\"recent_volume\":31003009,\"search_score\":28000,\"series_ticker\":\"KXBTCPERP\",\"series_title\":\"BTC\",\"tags\":[\"BTC\"],\"ticker\":\"KXBTCPERP\",\"title\":\"BTC\",\"topic_keywords\":[\"btc\",\"bitcoin\",\"crypto\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"total_market_count\":0,\"total_notional_volume\":42768947613.6983,\"total_series_volume\":0,\"total_volume\":5830132454,\"type\":\"margin\"},{\"active_market_count\":0,\"asset_class\":\"Crypto\",\"category\":\"Crypto\",\"contract_size\":0.001,\"derived_decimal_count\":1,\"event_subtitle\":\"\",\"event_ticker\":\"KXETHPERP\",\"event_title\":\"ETH\",\"fee_multiplier\":0,\"fee_type\":\"\",\"funding_rate\":0,\"funding_time\":\"2026-11-02T11:18:21.275812Z\",\"halt_sources\":[],\"is_closing\":false,\"is_new\":false,\"is_price_delta\":false,\"is_trending\":false,\"last_price\":2.2827,\"leverage_estimate\":4.8768,\"leverage_estimates\":{\"1000\":4.8737,\"10000\":4.8706,\"100000\":4.843,\"1000000\":4.7125},\"market_id\":\"14a2a2b8-f862-459c-afd1-0c956633a8e3\",\"markets\":[],\"previous_price\":2.2673,\"product_metadata\":{\"asset_name\":\"Ethereum\",\"categories\":[\"Crypto\"],\"category\":\"Crypto\",\"chart_gradient_start_color\":\"#80627EEA\",\"chart_gradient_start_dark_color\":\"#80627EEA\",\"chart_gradient_stop_color\":\"#00627EEA\",\"chart_gradient_stop_dark_color\":\"#00627EEA\",\"chart_line_color\":\"#627EEA\",\"chart_line_dark_color\":\"#627EEA\",\"custom_image_url\":\"https://assets.kalshi.com/app_casual/margin_images/2026-09-24/KXETHPERP.webp\",\"decimal_count\":2,\"description\":\"Ether is the native asset of Ethereum, the largest smart-contract blockchain in crypto. Ethereum powers a broad ecosystem that includes decentralized finance, stablecoins, NFTs, token issuance, and many onchain applications. ETH is used to pay transaction fees and secure the network through staking. It is often treated as the main benchmark for crypto application activity and smart-contract adoption. Network upgrades, fee trends, ETF developments, and staking flows can all influence how traders price ETH.\",\"funding_schedule\":\"0 */8 * * *\",\"index_provider\":\"CF Benchmarks' Ether-Dollar Real Time Index\",\"keywords\":[\"eth\",\"ether\",\"ethereum\",\"crypto\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"live_data_asset\":\"ETH\",\"market_screen_title\":\"ETH\",\"shareable_accent_color\":\"#627EEA\",\"shareable_layer2_background_color\":\"#667C72FF\",\"shareable_layer2_border_color\":\"#627EEA\",\"shareable_layer2_color\":\"#7C72FF\",\"shareable_layer2_gradient_bottom_color\":\"#7C72FF\",\"shareable_layer2_gradient_top_color\":\"#493CFF\",\"subaccount_id\":65,\"subcategory\":\"ETH\"},\"product_metadata_derived\":{},\"recent_notional_volume\":169911213.1925,\"recent_volume\":74575105,\"search_score\":27000,\"series_ticker\":\"KXETHPERP\",\"series_title\":\"ETH\",\"tags\":[\"ETH\"],\"ticker\":\"KXETHPERP\",\"title\":\"ETH\",\"topic_keywords\":[\"eth\",\"ether\",\"ethereum\",\"crypto\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"total_market_count\":0,\"total_notional_volume\":35068156935.532,\"total_series_volume\":0,\"total_volume\":15660253580,\"type\":\"margin\"},{\"active_market_count\":0,\"asset_class\":\"Indices\",\"category\":\"Indices\",\"contract_size\":0.0001,\"derived_decimal_count\":0,\"event_subtitle\":\"\",\"event_ticker\":\"KXUSTECH100PERP\",\"event_title\":\"US Tech 100\",\"fee_multiplier\":0,\"fee_type\":\"\",\"funding_rate\":0,\"funding_time\":\"2026-11-02T11:18:21.275812Z\",\"halt_sources\":[],\"is_closing\":false,\"is_new\":false,\"is_price_delta\":false,\"is_trending\":false,\"last_price\":3.5684,\"leverage_estimate\":10.5644,\"leverage_estimates\":{\"1000\":10.5644,\"10000\":10.5644,\"100000\":10.5644,\"1000000\":10.5644},\"market_id\":\"01a11c78-1b3e-7b33-833f-c905fe767b7e\",\"markets\":[],\"previous_price\":3.5382,\"product_metadata\":{\"asset_name\":\"US Tech 100\",\"categories\":[\"Indices\"],\"category\":\"Indices\",\"chart_gradient_start_color\":\"#80A452FF\",\"chart_gradient_start_dark_color\":\"#80A452FF\",\"chart_gradient_stop_color\":\"#00A452FF\",\"chart_gradient_stop_dark_color\":\"#00A452FF\",\"chart_line_color\":\"#A452FF\",\"chart_line_dark_color\":\"#A452FF\",\"custom_image_url\":\"https://assets.kalshi.com/app_casual/margin_images/2026-09-30/KXUSTECH100PERP.webp\",\"decimal_count\":2,\"description\":\"Kalshi offers exposure to large U.S. technology and growth companies through Kalshi's US Tech 100 index perpetual future. The underlying index is calculated by MerQube (https://merqube.com/indices/MQBUSTQT), which has historically shown 99%+ daily-return correlation with major U.S. technology benchmarks, including the Nasdaq-100\u00ae. It's a total return index, which means dividends are reinvested back into the index.\\n\\nThe index is made up of 100 large non-financial companies, many of them in technology. It is weighted by market capitalization, so the biggest companies like Nvidia, Meta and Google move the price much more than smaller ones. Because the index is concentrated in fewer companies and sectors than a broad 500-company index, it can move more sharply in either direction.\\n\\nWhat to watch: Earnings from the largest tech companies, spending on AI and data centers, Federal Reserve interest-rate decisions, and monthly inflation reports.\",\"funding_schedule\":\"0 16 * * *\",\"index_provider\":\"MerQube US Tech 100 TR Index\",\"keywords\":[\"us tech 100\",\"tech 100\",\"tech\",\"technology\",\"mqbustqt\",\"merqube\",\"equities\",\"stocks\",\"index\",\"indices\",\"nasdaq\",\"nasdaq 100\",\"nasdaq-100\",\"ndx\",\"qqq\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"live_data_asset\":\"MERQUBE:MQBUSTQT\",\"market_screen_title\":\"US Tech 100\",\"new_until\":\"2026-10-21T04:00:00Z\",\"shareable_accent_color\":\"#A452FF\",\"shareable_layer2_background_color\":\"#6627143D\",\"shareable_layer2_border_color\":\"#A452FF\",\"shareable_layer2_color\":\"#27143D\",\"shareable_layer2_gradient_bottom_color\":\"#27143D\",\"shareable_layer2_gradient_top_color\":\"#A452FF\",\"subaccount_id\":118,\"subcategory\":\"US Tech 100\",\"trading_hours\":\"Sun 6pm \u2013 Fri 5pm ET\"},\"product_metadata_derived\":{},\"recent_notional_volume\":25842076.8825,\"recent_volume\":7245124,\"search_score\":26000,\"series_ticker\":\"KXUSTECH100PERP\",\"series_title\":\"US Tech 100\",\"tags\":[\"US Tech 100\"],\"ticker\":\"KXUSTECH100PERP\",\"title\":\"US Tech 100\",\"topic_keywords\":[\"us tech 100\",\"tech 100\",\"tech\",\"technology\",\"mqbustqt\",\"merqube\",\"equities\",\"stocks\",\"index\",\"indices\",\"nasdaq\",\"nasdaq 100\",\"nasdaq-100\",\"ndx\",\"qqq\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"total_market_count\":0,\"total_notional_volume\":511641268.3407,\"total_series_volume\":0,\"total_volume\":140414233,\"type\":\"margin\"},{\"active_market_count\":0,\"asset_class\":\"Metals\",\"category\":\"Metals\",\"contract_size\":0.001,\"derived_decimal_count\":1,\"event_subtitle\":\"\",\"event_ticker\":\"KXGOLDPERP\",\"event_title\":\"Gold\",\"fee_multiplier\":0,\"fee_type\":\"\",\"funding_rate\":0.0005058754897293,\"funding_time\":\"2026-11-02T11:18:21.275812Z\",\"halt_sources\":[],\"is_closing\":false,\"is_new\":false,\"is_price_delta\":false,\"is_trending\":false,\"last_price\":3.9052,\"leverage_estimate\":15.2735,\"leverage_estimates\":{\"1000\":15.2735,\"10000\":15.2735,\"100000\":15.2735,\"1000000\":15.2735},\"market_id\":\"01a08625-937b-77b5-9d31-fac411449133\",\"markets\":[],\"previous_price\":3.8872,\"product_metadata\":{\"asset_name\":\"Gold\",\"categories\":[\"Metals\"],\"category\":\"Metals\",\"chart_gradient_start_color\":\"#40EE9819\",\"chart_gradient_start_dark_color\":\"#40F7D21A\",\"chart_gradient_stop_color\":\"#00EE9819\",\"chart_gradient_stop_dark_color\":\"#00F7D21A\",\"chart_line_color\":\"#EE9819\",\"chart_line_dark_color\":\"#F7D21A\",\"custom_image_url\":\"https://assets.kalshi.com/app_casual/margin_images/2026-09-24/KXGOLDPERP.webp\",\"decimal_count\":2,\"description\":\"Gold is a physical metal that has functioned as a store of value for thousands of years and is widely used as a hedge against inflation and currency weakness.\\n\\nKey factors in play: Central banks have been buying gold at an elevated pace in recent years, according to the World Gold Council, as some countries look to reduce their reliance on the US dollar. Periods of geopolitical tension also tend to boost demand for gold as a safer place to hold money. Because gold pays no interest, its price is also sensitive to Federal Reserve policy, rate expectations, and overall US dollar strength.\\n\\nWhat to watch: Federal Reserve meetings, CPI/PPI inflation releases, and comments from Fed officials.\",\"funding_schedule\":\"0 10 * * *\",\"index_provider\":\"Pyth Gold Reference Rate\",\"keywords\":[\"gold\",\"xau\",\"metals\",\"precious metals\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"live_data_asset\":\"PYTH:GOLD\",\"market_screen_title\":\"Gold\",\"shareable_accent_color\":\"#F7D21A\",\"shareable_layer2_background_color\":\"#663B3206\",\"shareable_layer2_border_color\":\"#F7D21A\",\"shareable_layer2_color\":\"#3B3206\",\"shareable_layer2_gradient_bottom_color\":\"#3B3206\",\"shareable_layer2_gradient_top_color\":\"#F7D21A\",\"subaccount_id\":89,\"subcategory\":\"Gold\"},\"product_metadata_derived\":{},\"recent_notional_volume\":21585410.5289,\"recent_volume\":5532191,\"search_score\":25000,\"series_ticker\":\"KXGOLDPERP\",\"series_title\":\"Gold\",\"tags\":[\"Gold\"],\"ticker\":\"KXGOLDPERP\",\"title\":\"Gold\",\"topic_keywords\":[\"gold\",\"xau\",\"metals\",\"precious metals\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"total_market_count\":0,\"total_notional_volume\":1922175426.7514,\"total_series_volume\":0,\"total_volume\":463456506,\"type\":\"margin\"},{\"active_market_count\":0,\"asset_class\":\"Metals\",\"category\":\"Metals\",\"contract_size\":0.1,\"derived_decimal_count\":3,\"event_subtitle\":\"\",\"event_ticker\":\"KXSILVERPERP\",\"event_title\":\"Silver\",\"fee_multiplier\":0,\"fee_type\":\"\",\"funding_rate\":0.000235912456382,\"funding_time\":\"2026-11-02T11:18:21.275812Z\",\"halt_sources\":[],\"is_closing\":false,\"is_new\":false,\"is_price_delta\":false,\"is_trending\":false,\"last_price\":5.027,\"leverage_estimate\":8.3012,\"leverage_estimates\":{\"1000\":8.3012,\"10000\":8.3012,\"100000\":8.3012,\"1000000\":8.2214},\"market_id\":\"01a08625-fce2-71b3-a0f6-e3aaa4a7606f\",\"markets\":[],\"previous_price\":4.9489,\"product_metadata\":{\"asset_name\":\"Silver\",\"categories\":[\"Metals\"],\"category\":\"Metals\",\"chart_gradient_start_color\":\"#40AEB1C9\",\"chart_gradient_start_dark_color\":\"#40AEB1C9\",\"chart_gradient_stop_color\":\"#00AEB1C9\",\"chart_gradient_stop_dark_color\":\"#00AEB1C9\",\"chart_line_color\":\"#AEB1C9\",\"chart_line_dark_color\":\"#AEB1C9\",\"custom_image_url\":\"https://assets.kalshi.com/app_casual/margin_images/2026-09-24/KXSILVERPERP.webp\",\"decimal_count\":2,\"description\":\"Silver combines two roles: it's held for some of the same reasons as gold, as protection against inflation or a weak dollar, and it's also an industrial material used in solar panels, electronics, and EVs.\\n\\nKey factors in play: The world has used more silver than it's mined for several years running, according to the Silver Institute, driven mainly by growing demand from solar panels and other manufacturing. The U.S. added silver to its list of critical minerals in 2025, reflecting its industrial importance. Solar makers have also been working to use less silver per panel to cut costs, which could ease that shortage over time. Silver's price still tends to move with the same broader forces as gold, like the Fed, the dollar, and inflation data.\\n\\nWhat to watch: How silver trades relative to gold (the \\\"gold/silver ratio\\\"), Federal Reserve meetings, and CPI releases.\",\"funding_schedule\":\"0 10 * * *\",\"index_provider\":\"Pyth Silver Reference Rate\",\"keywords\":[\"silver\",\"xag\",\"metals\",\"precious metals\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"live_data_asset\":\"PYTH:XAGUSD\",\"market_screen_title\":\"Silver\",\"shareable_accent_color\":\"#AEB1C9\",\"shareable_layer2_background_color\":\"#66292A30\",\"shareable_layer2_border_color\":\"#AEB1C9\",\"shareable_layer2_color\":\"#292A30\",\"shareable_layer2_gradient_bottom_color\":\"#292A30\",\"shareable_layer2_gradient_top_color\":\"#AEB1C9\",\"subaccount_id\":92,\"subcategory\":\"Silver\"},\"product_metadata_derived\":{},\"recent_notional_volume\":13737320.3335,\"recent_volume\":2758883,\"search_score\":24000,\"series_ticker\":\"KXSILVERPERP\",\"series_title\":\"Silver\",\"tags\":[\"Silver\"],\"ticker\":\"KXSILVERPERP\",\"title\":\"Silver\",\"topic_keywords\":[\"silver\",\"xag\",\"metals\",\"precious metals\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"total_market_count\":0,\"total_notional_volume\":924775235.8076,\"total_series_volume\":0,\"total_volume\":155988046,\"type\":\"margin\"},{\"active_market_count\":0,\"asset_class\":\"Energy\",\"category\":\"Energy\",\"contract_size\":0.01,\"derived_decimal_count\":2,\"event_subtitle\":\"\",\"event_ticker\":\"KXWTIFUTURE\",\"event_title\":\"WTI Oil\",\"fee_multiplier\":0,\"fee_type\":\"\",\"funding_rate\":0.0014590179031167,\"funding_time\":\"2026-11-02T11:18:21.275812Z\",\"halt_sources\":[],\"is_closing\":false,\"is_new\":false,\"is_price_delta\":false,\"is_trending\":false,\"last_price\":0.9884,\"leverage_estimate\":5.9741,\"leverage_estimates\":{\"1000\":5.9741,\"10000\":5.9741,\"100000\":5.9741,\"1000000\":5.9372},\"market_id\":\"01a1213a-7cab-79ab-8d92-bff284884f9f\",\"markets\":[],\"previous_price\":1.025,\"product_metadata\":{\"asset_name\":\"WTI Oil\",\"categories\":[\"Energy\"],\"category\":\"Energy\",\"chart_gradient_start_color\":\"#40D08000\",\"chart_gradient_start_dark_color\":\"#40D08000\",\"chart_gradient_stop_color\":\"#00D08000\",\"chart_gradient_stop_dark_color\":\"#00D08000\",\"chart_line_color\":\"#D08000\",\"chart_line_dark_color\":\"#D08000\",\"contract_type\":\"future\",\"custom_image_url\":\"https://kalshi-public-images.s3.us-east-2.amazonaws.com/energy-WTI-2.webp\",\"decimal_count\":2,\"description\":\"WTI (West Texas Intermediate) is the main U.S. crude oil benchmark. This contract is a long-dated future with a 10-year expiration. Prices are driven mostly by global supply and demand. Supply depends on how much major oil-exporting countries and U.S. producers put out, and can be disrupted by conflicts or sanctions. Demand tends to follow the health of the global economy and seasonal patterns, such as summer travel. U.S. crude inventories show whether the market has more oil than it needs or not enough.\\n\\nWhat to watch: Production decisions by major oil-exporting countries, weekly U.S. crude inventory reports, conflicts in oil-producing regions, and global economic data.\",\"expiration_date\":\"2036-10-14\",\"funding_schedule\":\"30 14 * * *\",\"index_provider\":\"Pyth\",\"keywords\":[\"wti\",\"west texas intermediate\",\"crude\",\"crude oil\",\"oil\",\"energy\",\"commodities\",\"1m\",\"one month\",\"future\",\"futures\"],\"live_data_asset\":\"PYTH:Commodities.Index.WTI1M-USD\",\"market_screen_title\":\"WTI Oil\",\"new_until\":\"2026-10-21T04:00:00Z\",\"shareable_accent_color\":\"#D08000\",\"shareable_layer2_background_color\":\"#663B2400\",\"shareable_layer2_border_color\":\"#D08000\",\"shareable_layer2_color\":\"#3B2400\",\"shareable_layer2_gradient_bottom_color\":\"#3B2400\",\"shareable_layer2_gradient_top_color\":\"#D08000\",\"subaccount_id\":95,\"subcategory\":\"Crude Oil\",\"trading_hours\":\"Sun 6pm \u2013 Fri 5pm ET\",\"trading_hours_detail\":\"Breaks Mon\u2013Thu 5\u20136pm ET\"},\"product_metadata_derived\":{},\"recent_notional_volume\":7495878.4982,\"recent_volume\":7453602,\"search_score\":23000,\"series_ticker\":\"KXWTIFUTURE\",\"series_title\":\"WTI Oil\",\"tags\":[\"Crude Oil\"],\"ticker\":\"KXWTIFUTURE\",\"title\":\"WTI Oil\",\"topic_keywords\":[\"wti\",\"west texas intermediate\",\"crude\",\"crude oil\",\"oil\",\"energy\",\"commodities\",\"1m\",\"one month\",\"future\",\"futures\"],\"total_market_count\":0,\"total_notional_volume\":215561104.4125,\"total_series_volume\":0,\"total_volume\":216754859,\"type\":\"margin\"},{\"active_market_count\":0,\"asset_class\":\"Crypto\",\"category\":\"Crypto\",\"contract_size\":0.1,\"derived_decimal_count\":3,\"event_subtitle\":\"\",\"event_ticker\":\"KXHYPEPERP\",\"event_title\":\"HYPE\",\"fee_multiplier\":0,\"fee_type\":\"\",\"funding_rate\":0,\"funding_time\":\"2026-11-02T11:18:21.275812Z\",\"halt_sources\":[],\"is_closing\":false,\"is_new\":false,\"is_price_delta\":false,\"is_trending\":false,\"last_price\":8.5448,\"leverage_estimate\":2.2844,\"leverage_estimates\":{\"1000\":2.283,\"10000\":2.277,\"100000\":2.249,\"1000000\":2.1154},\"market_id\":\"b6334d4a-bdd0-4cd9-82cf-419c1b2b2b4e\",\"markets\":[],\"previous_price\":8.7967,\"product_metadata\":{\"asset_name\":\"Hyperliquid\",\"categories\":[\"Crypto\"],\"category\":\"Crypto\",\"chart_gradient_start_color\":\"#808BFBE1\",\"chart_gradient_start_dark_color\":\"#8096FCE5\",\"chart_gradient_stop_color\":\"#008BFBE1\",\"chart_gradient_stop_dark_color\":\"#0096FCE5\",\"chart_line_color\":\"#56C8B4\",\"chart_line_dark_color\":\"#96FCE5\",\"custom_image_url\":\"https://assets.kalshi.com/app_casual/margin_images/2026-09-24/KXHYPEPERP.webp\",\"decimal_count\":2,\"description\":\"Hyperliquid is the token associated with Hyperliquid, a crypto trading ecosystem focused on high-performance onchain perpetual futures and exchange infrastructure. HYPE is closely tied to activity on the platform and to the broader narrative around decentralized derivatives trading. Traders often view it as a bet on onchain market structure, trading volume, and the growth of crypto-native exchange products. Sentiment around HYPE can move with platform adoption, incentive design, fee economics, and new product launches. It is usually followed as an exchange- and infrastructure-linked crypto asset rather than a simple payments token.\",\"funding_schedule\":\"0 */8 * * *\",\"index_provider\":\"CF Benchmarks' Hyperliquid-Dollar Spot Rate\",\"keywords\":[\"hype\",\"hyperliquid\",\"crypto\",\"perp\",\"perps\",\"perpetual\",\"perpetuals\"],\"live_data_asset\":\"HYPE\",\"market_screen_title\":\"HYPE\",\"shareable_accent_color\":\"#030E0C\",\"shareable_layer2_background_color\":\"#66072821\",\"shareable_