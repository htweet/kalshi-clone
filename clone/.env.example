# Parlance Exchange — environment variables (example only; never put real secrets in this file).
#
# The server reads these from the process environment; it does not load a .env file by itself.
#   bash / Git Bash:  set -a; . ./.env; set +a; npm start      (or: PORT=8080 npm start)
#   PowerShell:       $env:PORT=8080; npm start
# Copy to `.env` (git-ignored) for local use. Every variable read by clone/server/*.js must be listed here;
# `npm run lint` fails when one is missing (scripts/check-env-example.js).

# ---- server ---------------------------------------------------------------------------------------------
# HTTP port. Unset: try 3000-3019 and print the bound URL. Set: use exactly this port or exit with a message.
PORT=
# SQLite database file (default: clone/data/parlance.db). One server per file (single-instance lock).
DB_FILE=
# Global token-bucket rate limit for /v1 and /trade-api per client IP: burst size and refill per second.
RATE_BURST=300
RATE_PER_SEC=150

# ---- markets --------------------------------------------------------------------------------------------
# Rolling Above/Below market window in seconds.
ROLLING_WINDOW_SEC=900
# Perps funding interval override in milliseconds (0 = the product default schedule).
PERPS_FUNDING_INTERVAL_MS=0

# ---- live sports simulation -----------------------------------------------------------------------------
# From the CLI the simulation is on unless SPORTS=0; when the app is embedded (tests) it is off unless SPORTS=1.
SPORTS=
# Game seconds per real second.
SPORTS_SPEED=1
# Log requote / settlement errors from the simulation (any non-empty value).
SPORTS_DEBUG=

# ---- event live chat rate limits (writes only) ----------------------------------------------------------
CHAT_USER_BURST=8
CHAT_USER_PER_SEC=0.5
CHAT_IP_BURST=30
CHAT_IP_PER_SEC=3

# ---- identity, sessions and login security (SEC_IDENTITY_SPEC.md §22) ----
# First admin on first start (no default admin password exists). Leave unset to get a one-time setup URL in the
# console instead, or run `npm run create-admin` (ADMIN_NAME is its optional display name).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Password for the seeded demo traders (maple_quant@, harborwatch@, rainmaker@parlance.local). Unset: a random one is printed once.
DEMO_PASSWORD=
# Master key for field encryption (TOTP secrets), the audit-log HMAC chain and login-CSRF tokens. 64 hex chars, or any
# string (hashed). Unset: SECRET_KEY_FILE, else secret.key next to the database (created with mode 0600).
SECRET_KEY=
SECRET_KEY_FILE=
# Secure + __Host- cookie names: on automatically when NODE_ENV=production or the request is HTTPS; set 1 behind a
# TLS-terminating proxy.
SECURE_COOKIES=
NODE_ENV=
# scrypt cost as log2(N), 14-20 (default 16). Raising it re-hashes each password on its next successful login.
SCRYPT_LOG_N=

# ---- Perimeter security (server/security.js, server/bot.js; SEC_PERIMETER_SPEC.md §21) ----
# Extra origins allowed by CORS (comma-separated, e.g. https://app.example.com). The server's own origin is always allowed.
# ALLOWED_ORIGINS=
# Express `trust proxy` (true, a hop count, or loopback / a CIDR list). Needed for client IPs, X-Forwarded-Proto and HSTS
# behind a reverse proxy; leave unset when clients connect directly.
# TRUST_PROXY=
# Static assets: `dist` (hashed production bundle, built when missing or stale; the default for npm start and
# NODE_ENV=production) or `src` (unbundled sources; the default for tests and npm run dev).
# ASSETS=

# ---- Phase 3: accounts, identity and compliance (PHASE3_SPEC.md section 25) ----
# Identity verification gates deposits, withdrawals and trading. npm start / npm run dev turn it on unless KYC_REQUIRED=0;
# programmatic start() leaves it off unless KYC_REQUIRED=1, identity.kycRequired or NODE_ENV=production.
# KYC_REQUIRED=1
# Public origin used in emailed links, the document-verification QR code and WebAuthn (defaults to the request origin).
# PUBLIC_ORIGIN=https://exchange.example
# Email delivery (RS6). Unset outside production: messages go to the dev mailbox (/dev/mailbox, loopback only).
# SMTP_URL=smtp://user:password@smtp.example:587
# MAIL_FROM=no-reply@exchange.example
# SMS delivery (P3.2): JSON POST {to, body} to a gateway adapter. Unset outside production: dev SMS outbox.
# SMS_WEBHOOK_URL=https://sms-gateway.example/send
# SMS_WEBHOOK_TOKEN=

# ---- Payments, sandbox only (CLONE_SPEC.md section 26). No real money moves.
# Instant simulated "demo funds" (POST deposits / withdrawals without a method_id): 1 on, 0 off. Default: on outside
# production, off in production.
# PAYMENTS_DEMO_FUNDS=1
# Sandbox payment rails (test cards, test banks, a test chain): 1 on, 0 off. Default: on outside production, off in
# production (there are no real payment providers).
# PAYMENTS_SANDBOX=1

# ---- AI news summaries (Phase 5B, CLONE_SPEC.md §29.6) ----
# Optional external summarizer. It is used ONLY when BOTH variables are set; otherwise the offline extractive
# summarizer runs and nothing leaves the server. Choose the model yourself (no default is built in). Daily request and
# token budgets live in Admin > AI summaries; when a budget is used up the extractive summary is served instead.
ANTHROPIC_API_KEY=
AI_SUMMARY_MODEL=

# Web Push (CLONE_SPEC.md §31, server/webpush.js). The VAPID key pair is generated on first start and stored encrypted
# in the database (no key to configure). VAPID_SUBJECT is the contact sent to push services: a mailto: address or an
# https: URL of the operator (default mailto:push@parlance.invalid). PUSH_ALLOWED_HOSTS adds push-service host names
# (comma-separated; subdomains included) to the built-in list: FCM, Mozilla, Apple, Windows.
# VAPID_SUBJECT=mailto:ops@example.com
# PUSH_ALLOWED_HOSTS=

# Feature flags (CLONE_SPEC.md §33): technical overrides only; flags are managed in Admin › Feature flags (DB).
# Precedence: technical availability (SPORTS=0, PAYMENTS_SANDBOX=0, …: the module is not running) > FEATURE_FLAGS >
# the kill switch > the flag's DB state (on/off, schedule, deny/allow lists, region, rollout). Comma-separated key=on|off.
# FEATURE_FLAGS=perps=off,sports=on

# ---- Phase 7: public trading API (CLONE_SPEC.md section 35)
# FIX gateway TCP port when the api.fix flag is on (0 or unset = any free port; npm start prints nothing until it listens)
# FIX_PORT=9878
# Demo environment (play money, its own database) started by npm start; DEMO_API=0 turns it off
# DEMO_API=1
# DEMO_PORT=
# DEMO_DB_FILE=./data/parlance.demo.db
# Read by the developer-portal code samples (server/content/developer-docs.js), not by the server itself:
# PARLANCE_API_BASE=http://localhost:3000
# PARLANCE_KEY_ID=
# PARLANCE_PRIVATE_KEY_PATH=./key.pem

# Phase 7A (CLONE_SPEC.md §36): throttle of the waitlist newsletter outbox, in emails per minute (default 120).
# NEWSLETTER_PER_MINUTE=120

# ---- Phase 9A: production readiness (CLONE_SPEC.md §39; README "Deployment") ----
# Separate admin origin: the admin panel and /v1/admin/* answer only there, with their own cookie and a stricter CSP.
# ADMIN_ORIGIN=https://admin.example.ng
# Listen address inside the container (deploy/docker-compose.yml sets 0.0.0.0); loopback otherwise.
# HOST=127.0.0.1
# Master key ring (key rotation, RS4): JSON {"active":"k2","hmac":"k1","keys":{"k1":"<64 hex>","k2":"<64 hex>"}} in the
# environment, or a secrets file outside the data folder. `npm run keys -- rotate --file <path>` adds a key.
# SECRET_KEYRING=
# SECRET_KEYRING_FILE=/run/secrets/parlance_keyring
# Backup encryption key (separate from the master key; keep a copy off the server). 64 hex chars, or a secrets file.
# BACKUP_KEY=
# BACKUP_KEY_FILE=/run/secrets/parlance_backup_key
# The previous backup key after a backup-key rotation, so older backups still open.
# BACKUP_KEY_PREVIOUS=
# Object storage for media and identity documents, and the backup store: local (folders beside the database, the default),
# local:<folder>, or s3 (an S3-compatible bucket configured below; the provider is the owner's choice).
# OBJECT_STORAGE=local
# BACKUP_STORAGE=local
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=parlance-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=
# S3_PATH_STYLE=1
# BACKUP_S3_ENDPOINT=https://<provider endpoint>
# BACKUP_S3_REGION=auto
# BACKUP_S3_BUCKET=parlance-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=
# BACKUP_S3_PATH_STYLE=1
# BACKUPS=off stops the backup schedule and WAL shipping of `npm start` (the Launch readiness check turns red).
# BACKUPS=on
# Production requires DEMO_ACCOUNTS=off (the seeded demo traders can never sign in).
# DEMO_ACCOUNTS=off
# Logs: JSON lines in production; LOG_FORMAT=pretty for a terminal; LOG_LEVEL for the console before the database is open
# (the live level is the owner setting logs.level).
# LOG_FORMAT=json
# LOG_LEVEL=info
# Prometheus metrics on a private port, never the public listener (deploy/ scrapes it on the internal network).
# METRICS_PORT=9464
# METRICS_HOST=127.0.0.1
# METRICS_TOKEN=
# OpenTelemetry traces (flag ops.traces) are written to the logs; set an OTLP/HTTP collector to also send them there.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# The proxy's certificate file, read for the certificate-expiry alert (optional).
# TLS_CERT_FILE=/certs/site.crt
# /.well-known/security.txt contact (default mailto:security@<public host>).
# SECURITY_CONTACT=mailto:security@example.ng
# LAUNCH_GATE=1 makes Launch readiness gate the production switch outside production too (always on in production).
# LAUNCH_GATE=0
# FIX gateway listen address (FIX_HOST=0.0.0.0 inside the container; TLS ends at the proxy, deploy/caddy).
# FIX_HOST=127.0.0.1
